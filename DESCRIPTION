Package: ModalNet
Type: Package
Title: Regularized Parametric Modal Regression: Lasso, Elastic Net and Ridge
Version: 0.3.0
Authors@R: c(
    person("Christian E.", "Galarza", email = "chedgala@espol.edu.ec",
           role = c("aut", "cre", "cph"),
           comment = c(ORCID = "0000-0002-4818-6006",
                       affiliation = "Escuela Superior Politécnica del Litoral, Guayaquil, Ecuador")),
    person("Víctor H.", "Lachos", email = "hlachos@uconn.edu", role = "aut",
           comment = c(ORCID = "0000-0002-7239-2459",
                       affiliation = "University of Connecticut, Storrs, CT, USA")),
    person("Dashun", "Liu", email = "dashun.liu@uconn.edu", role = "aut",
